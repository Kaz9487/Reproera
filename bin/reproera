#!/usr/bin/env bash

set -u
set -o pipefail

REPROERA_ENTRYPOINT="${BASH_SOURCE[0]}"
while [[ -L "$REPROERA_ENTRYPOINT" ]]; do
    REPROERA_LINK_DIR="$(cd "$(dirname "$REPROERA_ENTRYPOINT")" && pwd -P)"
    REPROERA_LINK_TARGET="$(readlink "$REPROERA_ENTRYPOINT")"
    if [[ "$REPROERA_LINK_TARGET" == /* ]]; then
        REPROERA_ENTRYPOINT="$REPROERA_LINK_TARGET"
    else
        REPROERA_ENTRYPOINT="$REPROERA_LINK_DIR/$REPROERA_LINK_TARGET"
    fi
done
REPROERA_SCRIPT_DIR="$(cd "$(dirname "$REPROERA_ENTRYPOINT")" && pwd -P)"
REPROERA_ROOT="$(cd "${REPROERA_SCRIPT_DIR}/.." && pwd)"

# shellcheck source=../lib/common.sh
source "${REPROERA_ROOT}/lib/common.sh"
# shellcheck source=../lib/registry.sh
source "${REPROERA_ROOT}/lib/registry.sh"
# shellcheck source=../lib/doctor.sh
source "${REPROERA_ROOT}/lib/doctor.sh"
# shellcheck source=../lib/install.sh
source "${REPROERA_ROOT}/lib/install.sh"

reproera_usage() {
    cat <<'EOF'
Reproera builds developer tools into a user-owned prefix without sudo.

Usage:
  reproera doctor [--json]
  reproera list
  reproera init [PACKAGE[@VERSION] ...]
  reproera plan [PACKAGE[@VERSION]]
  reproera install [PACKAGE[@VERSION]] [--prefix PATH] [--jobs N] [--dry-run]
  reproera env [bash|zsh|tcsh]
  reproera shell-init [bash|zsh|tcsh] [--apply]
  reproera version
  reproera help

Examples:
  reproera doctor
  reproera init python@3.11.16
  reproera plan python@3.11.9
  reproera install tmux@3.3a --prefix "$HOME/.local"
  eval "$(reproera env bash)"
EOF
}

reproera_cmd_list() {
    printf '%-12s %-16s %s\n' "PACKAGE" "DEFAULT VERSION" "STATUS"
    printf '%-12s %-16s %s\n' "-------" "---------------" "------"
    local package
    for package in zlib bzip2 xz libffi sqlite perl openssl ncurses readline libevent python tmux gcc; do
        printf '%-12s %-16s %s\n' \
            "$package" "$(reproera_default_version "$package")" \
            "$(reproera_package_status "$package")"
    done
}

reproera_cmd_env() {
    local shell_name="${1:-bash}"
    reproera_emit_environment "$shell_name" "$(reproera_default_prefix)"
}

reproera_cmd_shell_init() {
    local shell_name="${1:-bash}"
    local apply=0
    if [[ "${2:-}" == "--apply" ]]; then
        apply=1
    elif [[ -n "${2:-}" ]]; then
        reproera_die "unknown shell-init option: ${2}"
    fi

    if [[ "$apply" -eq 0 ]]; then
        reproera_emit_shell_init "$shell_name"
        return
    fi

    reproera_apply_shell_init "$shell_name"
}

main() {
    local command="${1:-help}"
    if [[ "$#" -gt 0 ]]; then
        shift
    fi

    case "$command" in
        doctor) reproera_doctor "$@" ;;
        list) reproera_cmd_list "$@" ;;
        init) reproera_init_project "$@" ;;
        plan) reproera_plan "$@" ;;
        install) reproera_install "$@" ;;
        env) reproera_cmd_env "$@" ;;
        shell-init) reproera_cmd_shell_init "$@" ;;
        version|--version|-V) printf 'Reproera %s\n' "$REPROERA_VERSION" ;;
        help|-h|--help) reproera_usage ;;
        *) reproera_die "unknown command: $command (run 'reproera help')" ;;
    esac
}

main "$@"
